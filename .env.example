# Server-only signing secret. Generate with: openssl rand -base64 48
AUTH_SESSION_SECRET=

# Server-only scrypt hashes. Never put plaintext passwords in this file.
# Format: scrypt$<base64url salt>$<base64url derived key>
ADMIN_PASSWORD_HASH_PODCRAFTINDIA=
ADMIN_PASSWORD_HASH_OMKARSHIRVALKAR=
ADMIN_PASSWORD_HASH_SWAYAMUK1=
